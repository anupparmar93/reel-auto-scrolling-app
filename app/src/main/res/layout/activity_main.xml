<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TikTok AutoScroller"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#BBBBBB"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1) Accessibility settings kholo" />

        <TextView
            android:id="@+id/lblMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/seekMin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="59" />

        <TextView
            android:id="@+id/lblMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/seekMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60" />

        <TextView
            android:id="@+id/lblTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/seekTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="24" />

        <Switch
            android:id="@+id/swTikTok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sirf TikTok / YouTube / Instagram me scroll karo (bahar nikalte hi ruk jaye)"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2) Floating button dikhao / chhupao" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Use: TikTok, YouTube Shorts ya Instagram Reels kholo, floating ▶ button dabao. Dobara dabao to ruk jayega. Button ko pakad ke kahin bhi khiska sakte ho. Screen off ya battery low par apne aap band ho jata hai."
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
